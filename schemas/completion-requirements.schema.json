{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changebridge.local/schemas/completion-requirements.schema.json",
  "title": "ChangeBridge completion requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "authority", "status_values", "requirements"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project": {"const": "ChangeBridge"},
    "authority": {"const": "COMPLETION_CONTRACT.md"},
    "status_values": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "normative", "statement", "rationale", "scope", "source_conditions", "source_invariants", "dependencies", "current_status", "owner_stage", "verification_method", "minimum_evidence", "implementation_paths", "proof_paths", "failure_condition", "limitations", "review_notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^CB-[A-Z]+-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "normative": {"enum": ["MUST", "MUST NOT", "SHOULD", "MAY"]},
          "statement": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "source_conditions": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 16}, "uniqueItems": true},
          "source_invariants": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "current_status": {"enum": ["SATISFIED", "PARTIAL", "UNSATISFIED", "DEFERRED", "BLOCKED"]},
          "owner_stage": {"type": "string", "minLength": 1},
          "verification_method": {"type": "string", "minLength": 1},
          "minimum_evidence": {"enum": ["DESIGN_ONLY", "LOCAL_VERIFIED", "AWS_VERIFIED", "MEASURED", "EXTRAPOLATED", "UNCLAIMED"]},
          "implementation_paths": {"type": "array", "items": {"type": "string"}},
          "proof_paths": {"type": "array", "items": {"type": "string"}},
          "failure_condition": {"type": "string", "minLength": 1},
          "limitations": {"type": "string", "minLength": 1},
          "review_notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
