{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:changebridge:evidence:part2-stage1:1.0.0",
  "title": "ChangeBridge Part 2 Stage 1 evidence envelope",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "repository",
    "part",
    "stage",
    "evidence_type",
    "evidence_label",
    "source_commit",
    "source_tree",
    "result",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project": {"const": "ChangeBridge"},
    "repository": {"const": "bhuvaneshwaranmurugan21/changebridge-cdc-migration-platform"},
    "part": {"const": 2},
    "stage": {"const": 1},
    "evidence_type": {"type": "string", "minLength": 1},
    "evidence_label": {"enum": ["LOCAL_VERIFIED", "DESIGN_ONLY"]},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "result": {"enum": ["PASS", "PENDING_EXTERNAL_CLOSURE"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true
}
