{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changebridge.local/schemas/architecture-adr-index.schema.json",
  "title": "ChangeBridge architecture decision index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "required_decision_count", "decisions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "authority": {"const": "ChangeBridge Part 1 Stage 3"},
    "required_decision_count": {"const": 15},
    "decisions": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "evidence_label",
          "path",
          "requirements",
          "components"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^ADR-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "status": {"const": "ACCEPTED"},
          "evidence_label": {"const": "DESIGN_ONLY"},
          "path": {"type": "string", "pattern": "^docs/adr/ADR-[0-9]{3}-.*\\.md$"},
          "requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "components": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
