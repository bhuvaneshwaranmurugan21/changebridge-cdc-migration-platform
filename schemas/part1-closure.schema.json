{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changebridge.local/schemas/part1-closure.schema.json",
  "title": "ChangeBridge Part 1 closure authorities",
  "$defs": {
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths", "responsibility", "requirement_ids", "contract_ids", "invariant_ids", "prerequisites", "expected_tests", "expected_evidence", "rollback", "risk", "dependency_order", "parallel_class", "authorization_class", "non_goals"],
      "properties": {
        "id": {"type": "string", "pattern": "^VS-[0-9]{2}-[a-z0-9-]+$"},
        "paths": {"$ref": "#/$defs/non_empty_strings"},
        "responsibility": {"type": "string", "minLength": 20},
        "requirement_ids": {"$ref": "#/$defs/non_empty_strings"},
        "contract_ids": {"$ref": "#/$defs/non_empty_strings"},
        "invariant_ids": {"$ref": "#/$defs/non_empty_strings"},
        "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "expected_tests": {"$ref": "#/$defs/non_empty_strings"},
        "expected_evidence": {"$ref": "#/$defs/non_empty_strings"},
        "rollback": {"type": "string", "minLength": 20},
        "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "dependency_order": {"type": "integer", "minimum": 1},
        "parallel_class": {"type": "string", "minLength": 1},
        "authorization_class": {"type": "string", "minLength": 1},
        "non_goals": {"$ref": "#/$defs/non_empty_strings"}
      }
    },
    "implementation_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "authority", "base_commit", "non_authorizing", "slices"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "record_type": {"const": "implementation_readiness_manifest"},
        "authority": {"const": "ChangeBridge Part 1 Stage 5"},
        "base_commit": {"const": "f7ada638e0404afacaac604be400c1434858002f"},
        "non_authorizing": {"const": true},
        "slices": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/slice"}}
      }
    },
    "graph_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "depends_on", "local_validation", "managed_proof", "critical_path"],
      "properties": {
        "id": {"type": "string"},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "local_validation": {"$ref": "#/$defs/non_empty_strings"},
        "managed_proof": {"$ref": "#/$defs/non_empty_strings"},
        "critical_path": {"type": "boolean"}
      }
    },
    "dependency_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "authority", "non_authorizing", "nodes"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "record_type": {"const": "readiness_dependency_graph"},
        "authority": {"const": "ChangeBridge Part 1 Stage 5"},
        "non_authorizing": {"const": true},
        "nodes": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/graph_node"}}
      }
    },
    "interview_rehearsal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "requirement_id", "evidence_label", "status", "result", "required_topics", "rubric", "question_ids", "repository_references", "observed_errors", "corrections", "duration_minutes", "private_transcript_published", "limitations"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "record_type": {"const": "owner_interview_rehearsal"},
        "requirement_id": {"const": "CB-INTERVIEW-001"},
        "evidence_label": {"const": "LOCAL_VERIFIED"},
        "status": {"enum": ["PENDING_HUMAN_REHEARSAL", "PASS", "FAIL"]},
        "result": {"enum": ["PENDING", "PASS", "FAIL"]},
        "required_topics": {"$ref": "#/$defs/non_empty_strings"},
        "rubric": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "minimum", "maximum", "score"],
            "properties": {
              "dimension": {"type": "string"},
              "minimum": {"type": "integer", "minimum": 1},
              "maximum": {"type": "integer", "minimum": 1},
              "score": {"type": ["integer", "null"], "minimum": 1}
            }
          }
        },
        "question_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "repository_references": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "observed_errors": {"type": "array", "items": {"type": "string"}},
        "corrections": {"type": "array", "items": {"type": "string"}},
        "duration_minutes": {"type": ["integer", "null"], "minimum": 1},
        "private_transcript_published": {"const": false},
        "limitations": {"$ref": "#/$defs/non_empty_strings"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/implementation_manifest"},
    {"$ref": "#/$defs/dependency_graph"},
    {"$ref": "#/$defs/interview_rehearsal"}
  ]
}
