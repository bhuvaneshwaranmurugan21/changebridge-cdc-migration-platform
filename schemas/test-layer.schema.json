{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:changebridge:schema:test-layer:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "determinism_standard", "layers"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "authority": {"const": "ChangeBridge Part 1 Stage 4"},
    "determinism_standard": {"type": "object", "minProperties": 10, "additionalProperties": {"type": "string", "minLength": 1}},
    "layers": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "proof_target", "non_proof_boundary", "environment", "dependencies", "fixture_scale", "deterministic_controls", "expected_duration", "ci_placement", "failure_artifact", "future_owner", "requirement_ids", "invariant_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1}, "proof_target": {"type": "string", "minLength": 1},
          "non_proof_boundary": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}}, "fixture_scale": {"type": "string", "minLength": 1},
          "deterministic_controls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "expected_duration": {"type": "string", "minLength": 1}, "ci_placement": {"type": "string", "minLength": 1},
          "failure_artifact": {"type": "string", "minLength": 1}, "future_owner": {"type": "string", "minLength": 1},
          "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "invariant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}
