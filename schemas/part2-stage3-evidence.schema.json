{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://changebridge.local/schemas/part2-stage3-evidence.schema.json",
  "type":"object",
  "required":["schema_version","project","repository","part","stage","evidence_type","evidence_label","source_commit","source_tree","result","limitations"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "project":{"const":"ChangeBridge"},
    "repository":{"const":"bhuvaneshwaranmurugan21/changebridge-cdc-migration-platform"},
    "part":{"const":2},
    "stage":{"const":3},
    "evidence_type":{"type":"string","minLength":1},
    "evidence_label":{"const":"LOCAL_VERIFIED"},
    "source_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "source_tree":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "result":{"enum":["PASS","PENDING_EXTERNAL_CLOSURE"]},
    "limitations":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  },
  "additionalProperties":true
}
