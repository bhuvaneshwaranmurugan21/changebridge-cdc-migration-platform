{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:changebridge:contract:cdc-apply-manifest:1.0.0",
  "title": "ChangeBridge bounded CDC apply manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "manifest_id", "generation_id", "previous_frontier", "terminal_frontier", "source_history_digest", "predecessor_manifest_digest", "canonicalization_profile", "transactions"],
  "properties": {
    "contract_version": {"const": "changebridge-cdc-apply-manifest/1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generation_id": {"type": "string", "pattern": "^generation-[0-9a-f]{24}$"},
    "previous_frontier": {"type": "string", "pattern": "^[0-9A-F]+/[0-9A-F]{8}$"},
    "terminal_frontier": {"type": "string", "pattern": "^[0-9A-F]+/[0-9A-F]{8}$"},
    "source_history_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predecessor_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalization_profile": {"const": "changebridge-canonical-json/1.0.0"},
    "transactions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["transaction_id", "transaction_sequence", "commit_lsn", "expected_event_count", "ordered_event_ids", "event_set_digest", "tables"],
        "properties": {
          "transaction_id": {"type": "string", "minLength": 1},
          "transaction_sequence": {"type": "integer", "minimum": 1},
          "commit_lsn": {"type": "string"},
          "expected_event_count": {"type": "integer", "minimum": 1},
          "ordered_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "event_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "tables": {"type": "array", "minItems": 1, "items": {"enum": ["orders", "order_items"]}, "uniqueItems": true}
        }
      }
    }
  }
}
