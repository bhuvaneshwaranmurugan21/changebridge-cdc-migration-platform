{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:changebridge:contract:source-workload:1.0.0",
  "title": "Deterministic source workload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "workload_id", "seed", "tables", "key_distribution", "transaction_boundaries", "operation_mix", "source_schema_version", "start_condition", "end_condition", "fault_schedule", "expected_source_frontier", "expected_logical_state_digest"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "workload_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "tables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "key_distribution": {"enum": ["sequential", "uniform", "zipfian"]},
    "transaction_boundaries": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "operation_mix": {
      "type": "object", "additionalProperties": false,
      "required": ["insert", "update", "delete"],
      "properties": {"insert": {"type": "integer", "minimum": 0}, "update": {"type": "integer", "minimum": 0}, "delete": {"type": "integer", "minimum": 0}}
    },
    "source_schema_version": {"type": "string", "minLength": 1},
    "start_condition": {"type": "string", "minLength": 1},
    "end_condition": {"type": "string", "minLength": 1},
    "fault_schedule": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["step", "fault"], "properties": {"step": {"type": "integer", "minimum": 0}, "fault": {"type": "string", "minLength": 1}}}},
    "expected_source_frontier": {"$ref": "cdc-envelope-v1.schema.json#/$defs/source_position"},
    "expected_logical_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
