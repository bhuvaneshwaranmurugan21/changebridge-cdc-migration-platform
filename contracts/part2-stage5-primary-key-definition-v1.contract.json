{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:changebridge:contract:primary-key-definition:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source_table", "fields", "definition_digest"],
  "properties": {
    "contract_version": {"const": "changebridge-primary-key-definition/1.0.0"},
    "source_table": {"type": "string", "minLength": 1},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "name", "data_type", "nullable"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 0},
          "name": {"type": "string", "minLength": 1},
          "data_type": {"enum": ["string", "integer", "number", "boolean"]},
          "nullable": {"const": false}
        }
      }
    },
    "definition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
