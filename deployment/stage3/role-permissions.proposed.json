{
  "schema_version": "1.0.0",
  "status": "PROPOSED_NOT_AUTHORIZED",
  "execution_enabled": false,
  "role_name": "ChangeBridgePart3GitHubActionsRole",
  "proposed_permissions_boundary": "NONE_NO_NEW_BOUNDARY_RESOURCE",
  "actual_policy_and_boundary_readback_required": true,
  "proposed_state_key": "changebridge/part3/stage3/terraform.tfstate",
  "proposed_artifact_prefix": "changebridge/part3/stage3/immutable/",
  "unresolved_bindings": ["EXACT_KMS_KEY_ARN_FROM_VERIFIED_BOOTSTRAP_RECEIPT"],
  "binding_rule": "Execution remains blocked until this exact policy template is approved and the exact account-and-region-bound KMS key ARN is independently verified from the bootstrap receipt. Deterministic substitution of only that verified ARN and recording the resulting policy digest require no additional approval under the approved template. Any other policy or scope change requires separate approval. No wildcard KMS resource is permitted.",
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ExactBackendBucketLocation",
        "Effect": "Allow",
        "Action": "s3:GetBucketLocation",
        "Resource": "arn:aws:s3:::changebridge-p3s3-tfstate-857229544428-ap-southeast-2"
      },
      {
        "Sid": "ExactBackendStateListing",
        "Effect": "Allow",
        "Action": "s3:ListBucket",
        "Resource": "arn:aws:s3:::changebridge-p3s3-tfstate-857229544428-ap-southeast-2",
        "Condition": {
          "StringEquals": {"s3:prefix": "changebridge/part3/stage3/terraform.tfstate"}
        }
      },
      {
        "Sid": "VersionedBackendStateOnly",
        "Effect": "Allow",
        "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject"],
        "Resource": "arn:aws:s3:::changebridge-p3s3-tfstate-857229544428-ap-southeast-2/changebridge/part3/stage3/terraform.tfstate"
      },
      {
        "Sid": "ImmutableArtifactReadOnly",
        "Effect": "Allow",
        "Action": ["s3:GetObject", "s3:GetObjectVersion"],
        "Resource": "arn:aws:s3:::changebridge-p3s3-artifacts-857229544428-ap-southeast-2/changebridge/part3/stage3/immutable/*"
      },
      {
        "Sid": "ExactBackendLockTableOnly",
        "Effect": "Allow",
        "Action": ["dynamodb:DescribeTable", "dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:DeleteItem"],
        "Resource": "arn:aws:dynamodb:ap-southeast-2:857229544428:table/changebridge-p3s3-tf-locks"
      },
      {
        "Sid": "ExactVerifiedKeyViaRegionalS3Only",
        "Effect": "Allow",
        "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
        "Resource": "__BIND_EXACT_KMS_KEY_ARN_FROM_VERIFIED_BOOTSTRAP_RECEIPT__",
        "Condition": {
          "StringEquals": {
            "kms:CallerAccount": "857229544428",
            "kms:ViaService": "s3.ap-southeast-2.amazonaws.com"
          }
        }
      }
    ]
  }
}
